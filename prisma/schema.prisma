datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Material {
  id          Int      @id @default(autoincrement())
  topic       String
  grade       String
  region      String
  lessonPlan  String
  quizJson    String
  createdAt   DateTime @default(now())
}
