datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Material {
  id          Int      @id @default(autoincrement())
  topic       String
  grade       String
  region      String
  lessonPlan  String
  quizJson    String
  createdAt   DateTime @default(now())
}
